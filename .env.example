# Copiar a .env y completar. NUNCA commitear .env.
# Este archivo raíz lo lee tanto backend/ como las migraciones.


# ---- Base de datos (MySQL 8, InnoDB, utf8mb4) ----
# 3307 = el contenedor Docker del README. Para una MySQL propia, poné 3306.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=pedidoscofee
DB_PASSWORD=pedidoscofee
DB_NAME=pedidoscofee
# Tope de conexiones del pool. Dejar por debajo del límite real del hosting.
DB_CONNECTION_LIMIT=10

# ---- HTTP ----
PORT=3001
# URL pública de ESTE backend ya desplegado (ej. Render). Sin esto,
# MercadoPago no tiene a dónde mandar el aviso de "se aprobó el pago" — en
# local se deja vacío a propósito (localhost no es alcanzable desde afuera).
PUBLIC_BACKEND_URL=
# Filtro anti-bots (no identifica usuarios). Si se deja vacío, no se exige.
API_KEY=
# Orígenes permitidos para CORS, separados por coma.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# ---- Firebase Admin (validación de ID tokens del staff) ----
# Una de las dos: ruta a un JSON, o el JSON completo en una línea.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT=

# ---- Sesión de mesa (comensal, Fase 3) ----
# Secreto para firmar el table_session_token (JWT). Generar uno largo y aleatorio.
SESSION_TOKEN_SECRET=cambiar-por-un-secreto-largo-aleatorio
# Cuánto dura la sesión de un comensal sin volver a escanear el QR. 6hs por
# default (más que una comida real) — el frontend guarda el token en
# localStorage, así que salir y volver a entrar con el mismo link recupera
# la misma persona mientras no haya vencido.
SESSION_TOKEN_TTL_HOURS=6

# ---- Superficie pública sin login (Fase 3) ----
TURNSTILE_SECRET=
# Códigos de país ISO permitidos (geoip-lite). Vacío = sin firewall por país.
COUNTRY_ALLOWLIST=AR

# ---- MercadoPago (Fase 6) ----
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ---- Tests ----
TEST_BASE_URL=http://localhost:3001
